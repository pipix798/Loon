[Script]
http-request https://sea.api.lovekeyboard.com/v1/chat/keyboard-stream-msg script-path=https://raw.githubusercontent.com/pipix798/Loon/main/Scripts/Lovekey.js, timeout=60, tag=聊天
http-request https://sea.api.lovekeyboard.com/v1/chat/keyboard-ow-msg script-path=https://raw.githubusercontent.com/pipix798/Loon/main/Scripts/Lovekey.js, timeout=60, tag=开场白
http-request https://sea.api.lovekeyboard.com/v1/chat/stream_super_msg script-path=https://raw.githubusercontent.com/pipix798/Loon/main/Scripts/Lovekey.js, timeout=60, tag=超级对话
http-response https://sea.api.lovekeyboard.com/v2/account script-path=https://raw.githubusercontent.com/pipix798/Loon/main/Scripts/Lovekey.js, requires-body=true, timeout=60, tag=超级对话

[MITM]
hostname = sea.api.lovekeyboard.com